{
  "applyLinearityRule": "\\( \\frac{d}{dx} [af(x) + bg(x)] = a \\cdot f'(x) + b \\cdot g'(x) \\)",
  "applyPowerRule": "\\( \\frac{d}{dx} x^n = n x^{n-1} \\)",
  "applyChainRule": "\\( \\frac{d}{dx} f(g(x)) = f'(g(x)) \\cdot g'(x) \\)",
  "applyProductRule": "\\( \\frac{d}{dx} [f(x) \\cdot g(x)] = f'(x) \\cdot g(x) + f(x) \\cdot g'(x) \\)",
  "applyQuotientRule": "\\( \\frac{d}{dx} \\frac{f(x)}{g(x)} = \\frac{f'(x) \\cdot g(x) - f(x) \\cdot g'(x)}{[g(x)]^2} \\)",
  "applyConstantRule": "\\( \\frac{d}{dx} c = 0 \\)",
  "exponentialFunction": "\\( \\frac{d}{dx} e^x = e^x \\)",
  "logarithmicFunction": "\\( \\frac{d}{dx} \\ln(x) = \\frac{1}{x} \\)",
  "rewriteRecipTrigFunctions": "\\( \\csc, \\sec, \\cot \\)",
  "sineFunction": "\\( \\frac{d}{dx} \\sin(x) = \\cos(x) \\)",
  "cosineFunction": "\\( \\frac{d}{dx} \\cos(x) = -\\sin(x) \\)",
  "tangentFunction": "\\( \\frac{d}{dx} \\tan(x) = \\sec^2(x) \\)",
  "inverseSineFunction": "\\( \\frac{d}{dx} \\sin^{-1}(x) = \\frac{1}{\\sqrt{1-x^2}} \\)",
  "inverseCosineFunction": "\\( \\frac{d}{dx} \\cos^{-1}(x) = \\frac{-1}{\\sqrt{1-x^2}} \\)",
  "inverseTangentFunction": "\\( \\frac{d}{dx} \\tan^{-1}(x) = \\frac{1}{1+x^2} \\)"
}